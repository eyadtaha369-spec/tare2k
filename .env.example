# Google Apps Script Web App (/exec URL) — see apps-script/Code.gs
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Must match the SECRET script property in Apps Script
APPS_SCRIPT_SECRET=change-me-long-random-string

# Super admin login (username defaults to "admin"). Supervisors are created in the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Random string (32+ chars) used to sign login cookies
SESSION_SECRET=change-me-32-plus-random-characters

# Public site URL used inside WhatsApp pass links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://tare2k-theta.vercel.app
